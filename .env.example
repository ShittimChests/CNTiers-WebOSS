# 基础
PORT=3000
NODE_ENV=development
# 站点对外地址。生产环境**必须**设置，缺失直接启动失败——它决定会话 cookie 是否
# 带 Secure、CSP 是否升级不安全请求，以及 Microsoft OAuth 的 redirect_uri
#（后者必须与 Azure 应用注册里登记的完全一致）
APP_BASE_URL=http://localhost:3000

# 会话（生产环境必须设置高强度随机值；同时用于派生验证码的 HMAC 密钥）
# 生产环境下少于 32 个字符会拒绝启动：
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-long-random-string

# SuperAdmin 引导账号。每次启动都会保障这个不变量：ADMIN_USERNAME 对应的账号存在时
# 会被提升为 SuperAdmin；已有别的 SuperAdmin 时什么都不做；谁都没有才用下面的密码创建。
# 切库后若目标库里没有任何 SuperAdmin，也会按同一规则补一个。
# 也就是说 ADMIN_PASSWORD 不是「一次性初始密码」——请设一个真正的强口令。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe_12345

# 邮件（注册验证 / 密码重置）
# 在 https://resend.com/api-keys 创建 API key
RESEND_API_KEY=
# 必须是 RFC 5322 形式，且域名已在 Resend 验证通过（下面是形式示例，请换成自己的）
EMAIL_FROM=Subtier Staff <noreply@example.com>

# Microsoft OAuth（client_id 也可在后台 /admin/settings 中编辑；secret 只能放这里）
MS_OAUTH_CLIENT_ID=
MS_OAUTH_CLIENT_SECRET=
MS_OAUTH_TENANT=common

# 数据库
# 默认零配置使用 SQLite（data/subtier.db）。切换到 PostgreSQL / MySQL 请走后台
# /admin/database 面板——它会迁移数据并把连接信息写入 data/db-config.json。
# TLS 默认校验证书；自签证书 / 私有 CA / 按 IP 连接时需在面板上勾「跳过证书校验」。
#
# 数据目录，默认 <cwd>/data：
# DATA_DIR=./data
# 忽略 db-config.json 强制用 SQLite，救急用（例如目标库宕机导致进程起不来）：
# FORCE_SQLITE=1
